# ==============================================================================
# E-Ticket Platform Environment Configuration
# ==============================================================================

# Application Port Bindings (Docker Compose Host Ports)
FRONTEND_PORT=3000
BACKEND_PORT=4000
DB_PORT=5432

# Backend Application Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=*

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=eticket

# Full Database Connection URL
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# JWT & Session Configuration
JWT_SECRET=eticket-jwt-secret-key-change-in-production-2026
JWT_EXPIRES_IN=7d
QR_SIGNING_SECRET=eticket-qr-signing-secret-change-in-production-2026
COOKIE_SECURE=false
ORDER_RESERVATION_MINUTES=15

# Google OAuth 2.0 Sign-In (Web Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Frontend Configuration
VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
