datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  ORGANIZER
  CUSTOMER
  SCANNER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  EXPIRED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

enum PaymentProvider {
  MOCK
  KHQR
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  password         String
  firstName        String?
  lastName         String?
  organizationName String?
  phoneNumber      String?
  role             Role     @default(CUSTOMER)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  events             Event[]
  orders             Order[]
  scannerAssignments EventScanner[]
  checkedInTickets   Ticket[]       @relation("TicketCheckedInBy")

  @@map("users")
}

model Event {
  id          String      @id @default(uuid())
  title       String
  description String?
  category    String?
  venue       String
  location    String?
  bannerUrl   String?
  startDate   DateTime
  endDate     DateTime
  status      EventStatus @default(DRAFT)
  organizerId String
  organizer   User        @relation(fields: [organizerId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  ticketTypes TicketType[]
  scanners    EventScanner[]

  @@index([status, startDate])
  @@index([organizerId])
  @@index([category])
  @@map("events")
}

model TicketType {
  id                String   @id @default(uuid())
  eventId           String
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  price             Decimal  @db.Decimal(10, 2)
  totalQuantity     Int
  remainingQuantity Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tickets    Ticket[]
  orderItems OrderItem[]

  @@index([eventId])
  @@map("ticket_types")
}

model Order {
  id                 String      @id @default(uuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id])
  totalAmount        Decimal     @db.Decimal(10, 2)
  currency           String      @default("USD")
  status             OrderStatus @default(PENDING)
  paymentReference   String?
  expiresAt          DateTime?
  paidAt             DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  inventoryReleased  Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]
  tickets  Ticket[]

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("orders")
}

model OrderItem {
  id           String     @id @default(uuid())
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  quantity     Int
  unitPrice    Decimal    @db.Decimal(10, 2)
  subtotal     Decimal    @db.Decimal(10, 2)
  createdAt    DateTime   @default(now())

  @@index([orderId])
  @@index([ticketTypeId])
  @@map("order_items")
}

model Payment {
  id                String          @id @default(uuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          PaymentProvider @default(MOCK)
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("USD")
  status            PaymentStatus   @default(PENDING)
  idempotencyKey    String          @unique
  providerReference String?         @unique
  failureReason     String?
  metadata          Json?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model Ticket {
  id            String       @id @default(uuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId  String
  ticketType    TicketType   @relation(fields: [ticketTypeId], references: [id])
  ticketCode    String       @unique
  qrCode        String?
  qrTokenHash   String?      @unique
  status        TicketStatus @default(VALID)
  usedAt        DateTime?
  checkedInById String?
  checkedInBy   User?        @relation("TicketCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([orderId])
  @@index([ticketTypeId, status])
  @@map("tickets")
}

model EventScanner {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_scanners")
}
